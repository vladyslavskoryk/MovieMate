<!-- res/values/themes.xml -->
<resources>
    <style name="Theme.MovieMate" parent="android:Theme.Material.Light.NoActionBar">
        <!-- ваші інші атрибути -->
        <item name="android:colorBackground">@color/light_blue</item>
        <!-- визначте інші атрибути, якщо потрібно -->
    </style>

    <style name="Theme.MovieMate.Splash" parent="Theme.SplashScreen">
        <!-- посилаємося на атрибут colorBackground -->
        <item name="windowSplashScreenBackground">?attr/android:colorBackground</item>

        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.MovieMate</item>
    </style>
</resources>